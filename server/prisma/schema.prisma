generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CompanySettings {
  id                   String   @id @default("default")
  companyName          String   @default("Cogniviz Technologies")
  tagline              String   @default("\"AI TO SIMPLIFY, TECH TO AMPLIFY\"")
  logoUrl              String?  @default("/logo.png")
  address              String   @default("Gurunanak Pura, Nagpur")
  gstin                String   @default("27ABCDE1234F1Z5")
  state                String   @default("Maharashtra")
  stateCode            String   @default("27")
  country              String   @default("India")
  email                String   @default("contact.cogniviz@gmail.com")
  phone                String   @default("+91-9373879915")
  website              String   @default("www.cogniviz.com")

  // Bank & UPI
  bankName             String   @default("HDFC Bank")
  accountName          String   @default("Cogniviz Technologies")
  accountNumber        String   @default("50200012345678")
  ifsc                 String   @default("HDFC0001234")
  branch               String   @default("Nagpur Main Branch")
  upiId                String   @default("cogniviz@hdfcbank")

  // Invoice Numbering & Defaults
  invoicePrefix        String   @default("INV")
  invoiceNextNumber    Int      @default(1)
  financialYear        String   @default("2026-27")
  defaultCurrency      String   @default("INR")
  currencySymbol       String   @default("₹")
  defaultDeclaration   String   @default("We declare that this invoice shows the actual price of the goods/services described and that all particulars are true and correct.")
  invoiceFooter        String   @default("This is a Computer Generated Invoice")
  signatureUrl         String?
  stampUrl             String?

  // Template display toggles (Optional fields in Ref 2)
  showDeliveryNote     Boolean  @default(true)
  showModeOfPayment    Boolean  @default(true)
  showSupplierRef      Boolean  @default(true)
  showOtherRef         Boolean  @default(true)
  showBuyersOrder      Boolean  @default(true)
  showDespatchDoc      Boolean  @default(true)
  showDespatchedThrough Boolean @default(true)
  showDestination      Boolean  @default(true)
  showTermsOfDelivery  Boolean  @default(true)

  updatedAt            DateTime @updatedAt
}

model Customer {
  id             String    @id @default(cuid())
  customerCode   String?   @unique
  name           String
  companyName    String?
  gstin          String?
  email          String?
  phone          String?
  whatsapp       String?
  billingAddress String?
  state          String?
  stateCode      String?
  country        String    @default("India")
  notes          String?
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoices       Invoice[]
  payments       Payment[]
}

model Invoice {
  id                  String       @id @default(cuid())
  invoiceNumber       String       @unique
  invoiceDate         DateTime     @default(now())
  status              String       @default("DRAFT")

  customerId          String?
  customer            Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerSnapshot    String?
  supplierSnapshot    String?

  deliveryNote        String?
  paymentTerms        String?
  supplierRef         String?
  otherRef            String?
  buyersOrderNo       String?
  orderDate           DateTime?
  despatchDocNo       String?
  despatchDate        DateTime?
  despatchedThrough   String?
  destination         String?
  placeOfSupply       String?
  termsOfDelivery     String?

  isInterstate        Boolean      @default(false)

  subtotal            Float        @default(0)
  discount            Float        @default(0)
  taxableAmount       Float        @default(0)
  cgstAmount          Float        @default(0)
  sgstAmount          Float        @default(0)
  igstAmount          Float        @default(0)
  totalTaxAmount      Float        @default(0)
  otherCharges        Float        @default(0)
  roundOff            Float        @default(0)
  grandTotal          Float        @default(0)
  amountInWords       String?

  amountReceived      Float        @default(0)
  outstandingBalance  Float        @default(0)

  pdfUrl              String?
  emailStatus         String       @default("NOT_SENT")
  emailSentAt         DateTime?
  whatsappShareCount  Int          @default(0)
  notes               String?
  termsAndConditions  String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  items               InvoiceItem[]
  payments            Payment[]
  communications      InvoiceCommunication[]
  auditLogs           InvoiceAuditLog[]
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serialNumber  Int
  description   String
  hsnSac        String?
  quantity      Float    @default(1)
  unit          String   @default("Nos")
  rate          Float    @default(0)
  taxableAmount Float    @default(0)
  gstRate       Float    @default(18)
  cgstRate      Float    @default(0)
  sgstRate      Float    @default(0)
  igstRate      Float    @default(0)
  cgstAmount    Float    @default(0)
  sgstAmount    Float    @default(0)
  igstAmount    Float    @default(0)
  totalAmount   Float    @default(0)
}

model Payment {
  id             String    @id @default(cuid())
  invoiceId      String
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentDate    DateTime  @default(now())
  amount         Float
  paymentMethod  String    @default("UPI")
  transactionRef String?
  notes          String?
  receiptNumber  String?
  createdAt      DateTime  @default(now())
}

model ServiceItem {
  id             String   @id @default(cuid())
  name           String
  description    String?
  hsnSac         String?
  defaultRate    Float    @default(0)
  unit           String   @default("Nos")
  defaultGstRate Float    @default(18)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model InvoiceCommunication {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        String
  recipient   String
  status      String
  subject     String?
  message     String?
  metadata    String?
  createdAt   DateTime @default(now())
}

model InvoiceAuditLog {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action      String
  details     String?
  performedBy String   @default("Admin")
  createdAt   DateTime @default(now())
}

model FileRecord {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  category     String
  createdAt    DateTime @default(now())
}
